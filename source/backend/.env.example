# ParkWise Backend Configuration
SECRET_KEY=dev-only-secret-change-me
FLASK_DEBUG=1

# MySQL Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=parkwise

# MongoDB Configuration
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=parkwise
MONGO_TIMEOUT_MS=800

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
SESSION_COOKIE_SECURE=0

# Background Scheduler (set to 0 to disable if testing without MySQL)
SCHEDULER_ENABLED=1
